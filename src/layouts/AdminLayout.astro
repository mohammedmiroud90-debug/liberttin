---
import BaseHead from "../components/BaseHead.astro";
import { DEFAULT_LOCALE, getDir, type Locale } from "../i18n/locales";
import { pageTitle } from "../i18n/title";
import type { UiKey } from "../i18n/ui";
import "../styles/admin.css";

type Props = {
	locale?: Locale;
	titleKey?: UiKey;
};

const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const dir = getDir(locale);
---

<!doctype html>
<html lang={locale} dir={dir}>
	<head>
		<BaseHead
			title={pageTitle(locale, Astro.props.titleKey ?? "nav.dashboard")}
			description="Admin dashboard"
			locale={locale}
			noindex={true}
		/>
	</head>
	<body class="admin-react-root bg-gray-50 min-h-screen">
		<slot />
	</body>
</html>
