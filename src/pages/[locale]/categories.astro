---
import CategoriesPage from "../../views/CategoriesPage.astro";
import { getBlogPosts } from "../../lib/parse/posts";
import { localeStaticPaths, resolveLocaleParam } from "../../i18n/paths";

export function getStaticPaths() {
	return localeStaticPaths();
}

const locale = resolveLocaleParam(Astro.params.locale);
const { items } = await getBlogPosts(1, 200);
const posts = items.map((post) => ({
	slug: post.slug,
	title: post.title,
	publishedAt: new Date(post.publishedAt),
	category: post.category || "General",
}));
---

<CategoriesPage locale={locale} posts={posts} />
