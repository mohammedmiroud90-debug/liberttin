---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import { AdminProfile } from "../../../../components/admin/pages";
import { localeStaticPaths, resolveLocaleParam } from "../../../../i18n/paths";

export function getStaticPaths() {
	return localeStaticPaths();
}

const locale = resolveLocaleParam(Astro.params.locale);
---

<AdminLayout locale={locale}>
	<AdminProfile client:only="react" />
</AdminLayout>
