---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { SpaceProfile } from "../../../components/space/pages";
import { localeStaticPaths, resolveLocaleParam } from "../../../i18n/paths";

export function getStaticPaths() {
	return localeStaticPaths();
}

const locale = resolveLocaleParam(Astro.params.locale);
---

<AdminLayout locale={locale} titleKey="nav.space">
	<SpaceProfile client:only="react" />
</AdminLayout>
