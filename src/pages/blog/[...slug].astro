---
import { getAllPostSlugs } from "../../lib/parse/posts";
import { DEFAULT_LOCALE, localizedPath } from "../../i18n/locales";

export async function getStaticPaths() {
	const slugs = await getAllPostSlugs();
	return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug;
if (!slug) {
	return Astro.redirect(localizedPath(DEFAULT_LOCALE, "/blog/"), 301);
}

return Astro.redirect(localizedPath(DEFAULT_LOCALE, `/blog/${slug}/`), 301);
---
