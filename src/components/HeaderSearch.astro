---
import { localizedPath, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

type Props = {
	locale?: Locale;
};

const locale = Astro.props.locale ?? "en";
const searchHref = localizedPath(locale, "/search/");
---

<div class="header-search" data-search-root data-search-href={searchHref}>
	<button
		type="button"
		class="search-toggle"
		aria-label={t(locale, "search.button")}
		aria-expanded="false"
		data-search-open
	>
		<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
			<circle cx="11" cy="11" r="7"></circle>
			<path d="M20 20L16.65 16.65"></path>
		</svg>
	</button>

	<form class="search-form search-form-inline" hidden data-search-form>
		<input
			type="search"
			name="q"
			class="search-input"
			placeholder={t(locale, "search.placeholder")}
			autocomplete="off"
			data-search-input
		/>
		<button type="button" class="search-close" aria-label={t(locale, "search.close")} data-search-close>
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M18 6L6 18M6 6l12 12"></path>
			</svg>
		</button>
	</form>
</div>

<script>
	function initHeaderSearch() {
		const root = document.querySelector("[data-search-root]");
		const mobilePanel = document.querySelector("[data-search-mobile]");
		if (!root || !mobilePanel) return;

		const searchHref = root.getAttribute("data-search-href") || "/search/";
		const openBtn = root.querySelector("[data-search-open]");
		const inlineForm = root.querySelector("[data-search-form]");
		const mobileForm = mobilePanel.querySelector("[data-search-form-mobile]");
		const inlineInput = root.querySelector("[data-search-input]");
		const mobileInput = mobilePanel.querySelector("[data-search-input-mobile]");
		const closeInline = root.querySelector("[data-search-close]");
		const closeMobile = mobilePanel.querySelector("[data-search-close-mobile]");

		const isMobile = () => window.matchMedia("(max-width: 720px)").matches;

		function setOpen(open: boolean) {
			openBtn?.setAttribute("aria-expanded", String(open));
			if (isMobile()) {
				inlineForm?.setAttribute("hidden", "");
				openBtn?.removeAttribute("hidden");
				if (open) {
					mobilePanel.removeAttribute("hidden");
					(mobileInput as HTMLInputElement | null)?.focus();
				} else {
					mobilePanel.setAttribute("hidden", "");
					if (mobileInput) (mobileInput as HTMLInputElement).value = "";
				}
			} else {
				mobilePanel.setAttribute("hidden", "");
				if (open) {
					openBtn?.setAttribute("hidden", "");
					inlineForm?.removeAttribute("hidden");
					(inlineInput as HTMLInputElement | null)?.focus();
				} else {
					inlineForm?.setAttribute("hidden", "");
					openBtn?.removeAttribute("hidden");
					if (inlineInput) (inlineInput as HTMLInputElement).value = "";
				}
			}
		}

		function submitSearch(query: string) {
			const term = query.trim();
			if (!term) return;
			const url = new URL(searchHref, window.location.origin);
			url.searchParams.set("q", term);
			window.location.href = url.toString();
		}

		openBtn?.addEventListener("click", () => setOpen(true));
		closeInline?.addEventListener("click", () => setOpen(false));
		closeMobile?.addEventListener("click", () => setOpen(false));

		inlineForm?.addEventListener("submit", (e) => {
			e.preventDefault();
			submitSearch((inlineInput as HTMLInputElement)?.value ?? "");
		});

		mobileForm?.addEventListener("submit", (e) => {
			e.preventDefault();
			submitSearch((mobileInput as HTMLInputElement)?.value ?? "");
		});

		window.addEventListener("resize", () => {
			const open = openBtn?.getAttribute("aria-expanded") === "true";
			if (open) setOpen(true);
		});
	}

	initHeaderSearch();
	document.addEventListener("astro:page-load", initHeaderSearch);
</script>

<style is:global>
	.header-search {
		display: flex;
		align-items: center;
	}

	.search-toggle,
	.search-close {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.35rem;
		border: none;
		background: transparent;
		color: #fff;
		cursor: pointer;
		transition: color 0.15s ease;
	}

	.search-toggle:hover,
	.search-close:hover {
		color: #d1d5db;
	}

	.search-form {
		display: flex;
		align-items: center;
		position: relative;
	}

	.search-form[hidden] {
		display: none;
	}

	.search-toggle[hidden] {
		display: none;
	}

	.search-form-inline .search-input {
		width: 14rem;
	}

	.search-input {
		padding: 0.5rem 2rem 0.5rem 0.75rem;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 0;
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		font-size: 0.875rem;
		outline: none;
		transition: all 0.2s ease;
	}

	.search-input::placeholder {
		color: rgba(255, 255, 255, 0.6);
	}

	.search-input:focus {
		border-color: rgba(255, 255, 255, 0.6);
		background: rgba(255, 255, 255, 0.15);
	}

	.search-close {
		position: absolute;
		right: 0.25rem;
		color: rgba(255, 255, 255, 0.8);
	}

	.search-mobile-panel {
		background: #111;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		padding: 0.75rem 1.25rem;
	}

	.search-mobile-panel[hidden] {
		display: none;
	}

	.search-form-mobile {
		width: 100%;
		position: relative;
	}

	.search-form-mobile .search-input {
		width: 100%;
		box-sizing: border-box;
	}

	@media (min-width: 721px) {
		.search-mobile-panel {
			display: none !important;
		}
	}
</style>
