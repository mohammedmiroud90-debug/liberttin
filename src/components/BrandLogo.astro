---
type Props = {
	href?: string;
	text?: string;
	/** dark = white text for black headers; light = black text for white headers */
	variant?: "dark" | "light";
	fontSize?: number;
	fontWeight?: number;
	scale?: number;
	/** Show iconlogo.png to the right of the wordmark (default true). */
	showIcon?: boolean;
};

const {
	href = "/",
	text = "Libertta",
	variant = "dark",
	fontSize = 28,
	fontWeight = 700,
	scale = 1,
	showIcon = true,
} = Astro.props;

const color = variant === "dark" ? "#ffffff" : "#000000";
const computedSize = fontSize * scale;
const iconSize = Math.max(22, Math.round(computedSize * 0.85));
---

<a href={href} class="brand-logo">
	<span
		class="brand-logo__text"
		style={`--logo-size: ${computedSize}px; font-weight: ${fontWeight}; color: ${color};`}
	>
		{text}
	</span>
	{
		showIcon && (
			<img
				class:list={["brand-logo__icon", { "brand-logo__icon--on-light": variant === "light" }]}
				src="/iconlogo.png"
				alt=""
				width={iconSize}
				height={iconSize}
				style={`width: ${iconSize}px; height: ${iconSize}px;`}
				decoding="async"
			/>
		)
	}
</a>

<style>
	@font-face {
		font-family: "Libertinage";
		src: url("/Fontlogo/Libertinage.ttf") format("truetype");
		font-weight: 100 900;
		font-style: normal;
		font-display: swap;
	}

	.brand-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-width: 0;
		text-decoration: none;
		flex-shrink: 0;
	}

	.brand-logo__text {
		font-family: "Libertinage", serif;
		font-size: var(--logo-size, 28px);
		line-height: 1;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.brand-logo__icon {
		display: block;
		flex-shrink: 0;
		object-fit: contain;
		border-radius: 0.2rem;
		filter: brightness(0) invert(1);
	}

	.brand-logo__icon--on-light {
		filter: brightness(0);
	}
</style>
