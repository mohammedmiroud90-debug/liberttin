---
import { DEFAULT_LOCALE, localizedPath, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

type Props = { locale?: Locale };
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const policiesBase = localizedPath(locale, "/policies/");
---

<div id="cookie-banner" class="cookie-banner" hidden data-policies-url={`${policiesBase}#cookies`}>
	<div class="cookie-banner__content">
		<div class="cookie-banner__text">
			<h3 class="cookie-banner__title">{t(locale, "cookie.title")}</h3>
			<p class="cookie-banner__description">{t(locale, "cookie.description")}</p>
			<div class="cookie-banner__links">
				<a href={`${policiesBase}#privacy`} class="cookie-banner__link">{t(locale, "cookie.privacy")}</a>
				<a href={`${policiesBase}#cookies`} class="cookie-banner__link">{t(locale, "cookie.cookies")}</a>
				<a href={policiesBase} class="cookie-banner__link">{t(locale, "cookie.terms")}</a>
			</div>
		</div>
		<div class="cookie-banner__actions">
			<button type="button" class="cookie-banner__btn cookie-banner__btn--decline" data-cookie-decline>
				{t(locale, "cookie.decline")}
			</button>
			<button type="button" class="cookie-banner__btn cookie-banner__btn--settings" data-cookie-settings>
				{t(locale, "cookie.settings")}
			</button>
			<button type="button" class="cookie-banner__btn cookie-banner__btn--accept" data-cookie-accept>
				{t(locale, "cookie.accept")}
			</button>
		</div>
	</div>
	<button type="button" class="cookie-banner__close" aria-label={t(locale, "cookie.close")} data-cookie-close>
		<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M18 6L6 18M6 6l12 12"></path>
		</svg>
	</button>
</div>

<script>
	function initCookieBanner() {
		const banner = document.getElementById("cookie-banner");
		if (!banner) return;

		const cookieConsent = localStorage.getItem("cookieConsent");

		if (!cookieConsent) {
			banner.removeAttribute("hidden");
		}

		const acceptBtn = banner.querySelector("[data-cookie-accept]");
		const declineBtn = banner.querySelector("[data-cookie-decline]");
		const settingsBtn = banner.querySelector("[data-cookie-settings]");
		const closeBtn = banner.querySelector("[data-cookie-close]");

		function hideBanner() {
			banner.setAttribute("hidden", "");
		}

		acceptBtn?.addEventListener("click", () => {
			localStorage.setItem("cookieConsent", "accepted");
			hideBanner();
		});

		declineBtn?.addEventListener("click", () => {
			localStorage.setItem("cookieConsent", "declined");
			hideBanner();
		});

		settingsBtn?.addEventListener("click", () => {
			window.location.href = banner.dataset.policiesUrl || "/policies#cookies";
		});

		closeBtn?.addEventListener("click", () => {
			hideBanner();
		});
	}

	initCookieBanner();
	document.addEventListener("astro:page-load", initCookieBanner);
</script>

<style>
	.cookie-banner {
		position: fixed;
		bottom: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		max-width: 880px;
		width: calc(100% - 2rem);
		background: #fff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 1.25rem;
		box-shadow:
			0 4px 6px rgba(0, 0, 0, 0.04),
			0 18px 48px rgba(0, 0, 0, 0.14);
		z-index: 9999;
		overflow: hidden;
		animation: cookieSlideUp 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.cookie-banner[hidden] {
		display: none;
	}

	@keyframes cookieSlideUp {
		from {
			opacity: 0;
			transform: translateX(-50%) translateY(28px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateX(-50%) translateY(0) scale(1);
		}
	}

	.cookie-banner__content {
		display: flex;
		gap: 1.5rem;
		padding: 1.5rem 3rem 1.5rem 1.5rem;
		align-items: flex-start;
	}

	.cookie-banner__text {
		flex: 1;
		min-width: 0;
	}

	.cookie-banner__title {
		font-family: "Atkinson", sans-serif;
		font-size: 1.125rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 0.65rem 0;
		line-height: 1.3;
	}

	.cookie-banner__description {
		font-size: 0.875rem;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
		margin: 0 0 0.9rem 0;
	}

	.cookie-banner__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.1rem;
		margin-bottom: 0.25rem;
	}

	.cookie-banner__link {
		font-size: 0.8125rem;
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
		transition: color 0.2s ease;
		font-weight: 500;
	}

	.cookie-banner__link:hover {
		color: var(--accent-dark);
	}

	.cookie-banner__actions {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex-shrink: 0;
		min-width: 148px;
	}

	.cookie-banner__btn {
		padding: 0.65rem 1.2rem;
		border: none;
		border-radius: 999px;
		font-family: "Atkinson", sans-serif;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.025em;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
		white-space: nowrap;
	}

	.cookie-banner__btn--decline {
		background: transparent;
		color: rgb(var(--gray-dark));
		border: 1px solid rgba(0, 0, 0, 0.12);
	}

	.cookie-banner__btn--decline:hover {
		background: rgba(0, 0, 0, 0.04);
		border-color: rgba(0, 0, 0, 0.2);
	}

	.cookie-banner__btn--settings {
		background: var(--accent);
		color: #fff;
	}

	.cookie-banner__btn--settings:hover {
		background: var(--accent-dark);
		transform: translateY(-1px);
		box-shadow: 0 6px 14px rgba(35, 55, 255, 0.22);
	}

	.cookie-banner__btn--accept {
		background: rgb(var(--black));
		color: #fff;
	}

	.cookie-banner__btn--accept:hover {
		background: #222;
		transform: translateY(-1px);
		box-shadow: 0 6px 14px rgba(0, 0, 0, 0.22);
	}

	.cookie-banner__close {
		position: absolute;
		top: 0.85rem;
		right: 0.85rem;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: none;
		background: rgba(0, 0, 0, 0.04);
		color: rgb(var(--gray));
		cursor: pointer;
		border-radius: 999px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: background 0.2s ease, color 0.2s ease;
	}

	:global([dir="rtl"]) .cookie-banner__close {
		right: auto;
		left: 0.85rem;
	}

	.cookie-banner__close:hover {
		background: rgba(0, 0, 0, 0.08);
		color: rgb(var(--black));
	}

	@media (max-width: 768px) {
		.cookie-banner {
			bottom: 1rem;
			width: calc(100% - 1.25rem);
			max-width: none;
			border-radius: 1.1rem;
		}

		.cookie-banner__content {
			flex-direction: column;
			padding: 1.35rem 2.75rem 1.35rem 1.25rem;
		}

		.cookie-banner__actions {
			width: 100%;
			min-width: auto;
		}

		.cookie-banner__btn {
			width: 100%;
		}

		.cookie-banner__close {
			top: 0.7rem;
			right: 0.7rem;
		}

		:global([dir="rtl"]) .cookie-banner__close {
			right: auto;
			left: 0.7rem;
		}
	}

	@media (max-width: 480px) {
		.cookie-banner__links {
			flex-direction: column;
			gap: 0.45rem;
		}
	}
</style>
