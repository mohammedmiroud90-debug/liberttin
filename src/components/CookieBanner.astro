---
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";

type Props = { locale?: Locale };
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
---

<div id="cookie-banner" class="cookie-banner" hidden>
	<div class="cookie-banner__content">
		<div class="cookie-banner__text">
			<h3 class="cookie-banner__title">We use cookies and other technologies.</h3>
			<p class="cookie-banner__description">
				This website uses cookies, web beacons, JavaScript and similar technologies. 
				We accept that companies and third parties may create user profiles for 
				personalization, market research and advertising. While information may be 
				shared with third parties, it cannot be combined with personal data. 
				You can find detailed information on this subject and how to withdraw your 
				consent in the site's privacy policy.
			</p>
			<div class="cookie-banner__links">
				<a href="/policies#privacy" class="cookie-banner__link">Privacy Policy</a>
				<a href="/policies#cookies" class="cookie-banner__link">Cookie Policy</a>
				<a href="/policies" class="cookie-banner__link">Terms & Conditions</a>
			</div>
		</div>
		<div class="cookie-banner__actions">
			<button type="button" class="cookie-banner__btn cookie-banner__btn--decline" data-cookie-decline>
				DECLINE
			</button>
			<button type="button" class="cookie-banner__btn cookie-banner__btn--settings" data-cookie-settings>
				SETTINGS
			</button>
			<button type="button" class="cookie-banner__btn cookie-banner__btn--accept" data-cookie-accept>
				OK
			</button>
		</div>
	</div>
	<button type="button" class="cookie-banner__close" aria-label="Close" data-cookie-close>
		<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M18 6L6 18M6 6l12 12"></path>
		</svg>
	</button>
</div>

<script>
	function initCookieBanner() {
		const banner = document.getElementById('cookie-banner');
		if (!banner) return;

		const cookieConsent = localStorage.getItem('cookieConsent');
		
		// Show banner if no consent given
		if (!cookieConsent) {
			banner.removeAttribute('hidden');
		}

		const acceptBtn = banner.querySelector('[data-cookie-accept]');
		const declineBtn = banner.querySelector('[data-cookie-decline]');
		const settingsBtn = banner.querySelector('[data-cookie-settings]');
		const closeBtn = banner.querySelector('[data-cookie-close]');

		function hideBanner() {
			banner.setAttribute('hidden', '');
		}

		acceptBtn?.addEventListener('click', () => {
			localStorage.setItem('cookieConsent', 'accepted');
			hideBanner();
		});

		declineBtn?.addEventListener('click', () => {
			localStorage.setItem('cookieConsent', 'declined');
			hideBanner();
		});

		settingsBtn?.addEventListener('click', () => {
			window.location.href = '/policies#cookies';
		});

		closeBtn?.addEventListener('click', () => {
			hideBanner();
		});
	}

	initCookieBanner();
	document.addEventListener('astro:page-load', initCookieBanner);
</script>

<style>
	.cookie-banner {
		position: fixed;
		bottom: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		max-width: 850px;
		width: calc(100% - 2rem);
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
		z-index: 9999;
		animation: slideUp 0.4s ease-out;
	}

	.cookie-banner[hidden] {
		display: none;
	}

	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateX(-50%) translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateX(-50%) translateY(0);
		}
	}

	.cookie-banner__content {
		display: flex;
		gap: 1.5rem;
		padding: 1.75rem 3rem 1.75rem 1.75rem;
		align-items: flex-start;
	}

	.cookie-banner__text {
		flex: 1;
	}

	.cookie-banner__title {
		font-family: "Atkinson", sans-serif;
		font-size: 1.125rem;
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 0.75rem 0;
		line-height: 1.3;
	}

	.cookie-banner__description {
		font-size: 0.875rem;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
		margin: 0 0 1rem 0;
	}

	.cookie-banner__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin-bottom: 0.5rem;
	}

	.cookie-banner__link {
		font-size: 0.8125rem;
		color: #0066cc;
		text-decoration: underline;
		transition: color 0.2s ease;
		font-weight: 500;
	}

	.cookie-banner__link:hover {
		color: #004999;
	}

	.cookie-banner__actions {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		flex-shrink: 0;
		min-width: 140px;
	}

	.cookie-banner__btn {
		padding: 0.625rem 1.25rem;
		border: none;
		border-radius: 6px;
		font-family: "Atkinson", sans-serif;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.025em;
		cursor: pointer;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.cookie-banner__btn--decline {
		background: transparent;
		color: rgb(var(--gray-dark));
		border: 1px solid rgb(var(--gray-light));
	}

	.cookie-banner__btn--decline:hover {
		background: rgb(var(--gray-light));
		border-color: rgb(var(--gray));
	}

	.cookie-banner__btn--settings {
		background: #0066cc;
		color: #fff;
	}

	.cookie-banner__btn--settings:hover {
		background: #0052a3;
		transform: translateY(-1px);
		box-shadow: 0 4px 8px rgba(0, 102, 204, 0.25);
	}

	.cookie-banner__btn--accept {
		background: rgb(var(--black));
		color: #fff;
	}

	.cookie-banner__btn--accept:hover {
		background: #333;
		transform: translateY(-1px);
		box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25);
	}

	.cookie-banner__close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		padding: 0.5rem;
		border: none;
		background: transparent;
		color: rgb(var(--gray));
		cursor: pointer;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
	}

	.cookie-banner__close:hover {
		background: rgb(var(--gray-light));
		color: rgb(var(--black));
	}

	@media (max-width: 768px) {
		.cookie-banner {
			bottom: 1rem;
			width: calc(100% - 1rem);
			max-width: none;
		}

		.cookie-banner__content {
			flex-direction: column;
			padding: 1.5rem 3rem 1.5rem 1.25rem;
		}

		.cookie-banner__actions {
			width: 100%;
			min-width: auto;
		}

		.cookie-banner__btn {
			width: 100%;
		}

		.cookie-banner__close {
			top: 0.75rem;
			right: 0.75rem;
		}
	}

	@media (max-width: 480px) {
		.cookie-banner__links {
			flex-direction: column;
			gap: 0.5rem;
		}
	}
</style>
