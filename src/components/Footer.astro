---
import BrandLogo from "./BrandLogo.astro";
import { DEFAULT_LOCALE, localizedPath, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

type Props = { locale?: Locale };
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const today = new Date();
const homeHref = localizedPath(locale, "/");
const contactHref = localizedPath(locale, "/contact/");
const policiesHref = localizedPath(locale, "/policies/");
---

<footer>
	<div class="footer-content">
		<div class="footer-logo">
			<BrandLogo href={homeHref} text="Libertta" variant="light" fontSize={32} fontWeight={700} showIcon={true} />
		</div>

		<div class="footer-copy-wrap">
			<section class="footer-block">
				<h2 class="footer-heading">{t(locale, "footer.learnTitle")}</h2>
				<p class="footer-copy">{t(locale, "footer.learnBody")}</p>
			</section>

			<section class="footer-block footer-block--curious">
				<h2 class="footer-heading">{t(locale, "footer.curiousTitle")}</h2>
				<p class="footer-tagline">{t(locale, "footer.curiousBody")}</p>
			</section>
		</div>

		<div class="footer-social">
			<a href="mailto:contact@liberttin.blog" target="_blank" rel="noopener noreferrer" aria-label="Email">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
					<polyline points="22,6 12,13 2,6"></polyline>
				</svg>
			</a>
			<a href="https://x.com/liberttin" target="_blank" rel="noopener noreferrer" aria-label="X">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 10.24H16.17l-5.214-6.817L4.99 20.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
			<a href="https://github.com/liberttin" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
					<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
				</svg>
			</a>
			<a href="https://linkedin.com/company/liberttin" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
				</svg>
			</a>
		</div>
	</div>
	<div class="footer-bottom">
		<div class="footer-links">
			<a href={contactHref}>{t(locale, "nav.contact")}</a>
			<span>•</span>
			<a href={policiesHref}>{t(locale, "nav.policies")}</a>
		</div>
		<div class="footer-copyright">
			&copy; {today.getFullYear()} — {t(locale, "footer.rights")}
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1.25em 6em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-content {
		width: 100%;
		margin: 0 auto;
	}
	.footer-logo {
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 1.75em;
	}
	.footer-logo :global(.brand-logo) {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.footer-logo :global(.brand-logo__icon) {
		width: 28px;
		height: 28px;
		object-fit: contain;
		border-radius: 0.25rem;
		flex-shrink: 0;
		filter: brightness(0);
	}
	.footer-copy-wrap {
		width: min(100%, 34rem);
		margin: 0 auto;
		padding: 0 0.5rem;
		text-align: center;
	}
	.footer-block {
		margin: 0 auto 1.75rem;
	}
	.footer-block--curious {
		margin-bottom: 1.5rem;
	}
	.footer-heading {
		margin: 0 0 0.65rem;
		font-family: "Atkinson", sans-serif;
		font-size: 1.35rem;
		font-weight: 700;
		color: rgb(var(--black));
		line-height: 1.25;
		text-align: center;
	}
	.footer-copy {
		margin: 0 auto;
		font-size: 1rem;
		line-height: 1.65;
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-tagline {
		margin: 0 auto;
		font-size: 1.05rem;
		line-height: 1.55;
		color: rgb(var(--gray-dark));
		font-weight: 500;
		text-align: center;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
		font-size: 0.95rem;
	}
	.footer-links a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.footer-links a:hover {
		color: #2563eb;
		text-decoration-color: #2563eb;
	}
	.footer-links span {
		color: rgb(var(--gray-light));
	}
	.footer-social {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 0.25em;
		margin-bottom: 0.25em;
	}
	.footer-social a {
		text-decoration: none;
		color: #2563eb;
	}
	.footer-social a:hover {
		color: #1d4ed8;
	}
	.footer-copyright {
		margin-top: 0.35rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
	.footer-bottom {
		margin-top: 1.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(var(--gray-light), 0.9);
	}
</style>
