---
import HeaderLink from "./HeaderLink.astro";
import BrandLogo from "./BrandLogo.astro";
import HeaderSearch from "./HeaderSearch.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LoginModal from "./LoginModal.astro";
import { getLocaleFromPath, localizedPath, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

type Props = {
	locale?: Locale;
};

const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const homeHref = localizedPath(locale, "/");
const blogHref = localizedPath(locale, "/blog/");
const aboutHref = localizedPath(locale, "/about/");
const platformHref = localizedPath(locale, "/about/");
const categoriesHref = localizedPath(locale, "/categories/");
const contactHref = localizedPath(locale, "/contact/");
const policiesHref = localizedPath(locale, "/policies/");
const loginHref = localizedPath(locale, "/login/");
const adminHref = localizedPath(locale, "/admin/");
const spaceHref = localizedPath(locale, "/space/");
---

<header data-admin-href={adminHref} data-space-href={spaceHref}>
	<nav>
		<h2>
			<BrandLogo href={homeHref} text="Libertta" variant="dark" fontSize={36} fontWeight={700} />
		</h2>
		<div class="internal-links">
			<HeaderLink href={homeHref}>{t(locale, "nav.home")}</HeaderLink>
			<HeaderLink href={blogHref}>{t(locale, "nav.blog")}</HeaderLink>
			<HeaderLink href={aboutHref}>{t(locale, "nav.about")}</HeaderLink>
			<HeaderLink href={platformHref}>{t(locale, "nav.platform")}</HeaderLink>
			<HeaderLink href={categoriesHref}>{t(locale, "nav.categories")}</HeaderLink>
			<HeaderLink href={contactHref}>{t(locale, "nav.contact")}</HeaderLink>
			<HeaderLink href={policiesHref}>{t(locale, "nav.policies")}</HeaderLink>
		</div>
		<div class="header-actions">
			<button
				type="button"
				class="header-subscribe"
				data-subscribe-open
			>
				{t(locale, "nav.subscribe")}
			</button>
			<button
				type="button"
				class="header-user"
				data-header-user
				data-login-open
				aria-label={t(locale, "nav.signIn")}
				title={t(locale, "nav.signIn")}
			>
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="M20 21a8 8 0 0 0-16 0"></path>
					<circle cx="12" cy="8" r="4"></circle>
				</svg>
			</button>
			<HeaderSearch locale={locale} />
			<LanguageSwitcher locale={locale} />
			<button class="mobile-menu-toggle" aria-label={t(locale, "nav.menu")} data-mobile-menu-toggle>
				<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
					<path class="menu-icon" d="M3 12h18M3 6h18M3 18h18"></path>
					<path class="close-icon" style="display: none;" d="M18 6L6 18M6 6l12 12"></path>
				</svg>
			</button>
			<div class="social-links">
				<a href="https://m.webtoo.ls/@astro" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Follow Astro on Mastodon</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
						><path
							fill="currentColor"
							d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a3.614 3.614 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522c0-.859.22-1.541.66-2.046.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764.442.505.661 1.187.661 2.046v4.203z"
						></path></svg
					>
				</a>
				<a href="https://x.com/liberttin" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Follow Libertta on X</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
						><path
							fill="currentColor"
							d="M12.163 1.5h2.205l-4.818 5.507L15.5 14.5h-4.938l-3.868-5.054L2.3 14.5H.094l5.152-5.891L.5 1.5h5.063l3.495 4.633L12.163 1.5zm-.774 11.668h1.222L4.764 2.76H3.452l7.937 10.408z"
						></path></svg
					>
				</a>
				<a href="https://github.com/withastro/astro" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Go to Astro's GitHub repo</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
						><path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path></svg
					>
				</a>
			</div>
		</div>
	</nav>
	<div class="mobile-menu" data-mobile-menu>
		<div class="mobile-menu-links">
			<a href={homeHref} class="mobile-menu-link">{t(locale, "nav.home")}</a>
			<a href={blogHref} class="mobile-menu-link">{t(locale, "nav.blog")}</a>
			<a href={aboutHref} class="mobile-menu-link">{t(locale, "nav.about")}</a>
			<a href={platformHref} class="mobile-menu-link">{t(locale, "nav.platform")}</a>
			<a href={categoriesHref} class="mobile-menu-link">{t(locale, "nav.categories")}</a>
			<a href={contactHref} class="mobile-menu-link">{t(locale, "nav.contact")}</a>
			<a href={policiesHref} class="mobile-menu-link">{t(locale, "nav.policies")}</a>
			<button type="button" class="mobile-menu-link mobile-menu-subscribe" data-subscribe-open>
				{t(locale, "nav.subscribe")}
			</button>
			<button type="button" class="mobile-menu-link" data-login-open data-mobile-user>
				{t(locale, "nav.signIn")}
			</button>
		</div>
	</div>

	<div class="search-mobile-panel" hidden data-search-mobile>
		<form class="search-form search-form-mobile" data-search-form-mobile>
			<input
				type="search"
				name="q"
				class="search-input"
				placeholder={t(locale, "search.placeholder")}
				autocomplete="off"
				data-search-input-mobile
			/>
			<button type="button" class="search-close" aria-label={t(locale, "search.close")} data-search-close-mobile>
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M18 6L6 18M6 6l12 12"></path>
				</svg>
			</button>
		</form>
	</div>
</header>
<div class="subscribe-modal" data-subscribe-modal hidden>
	<div class="subscribe-modal__backdrop" data-subscribe-close></div>
	<div class="subscribe-modal__panel" role="dialog" aria-modal="true" aria-labelledby="subscribe-modal-title">
		<button type="button" class="subscribe-modal__close" aria-label="Close" data-subscribe-close>
			<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M18 6L6 18M6 6l12 12"></path>
			</svg>
		</button>

		<div class="subscribe-modal__grid">
			<aside class="subscribe-modal__aside" aria-hidden="true">
				<div class="subscribe-modal__orb subscribe-modal__orb--one"></div>
				<div class="subscribe-modal__orb subscribe-modal__orb--two"></div>
				<div class="subscribe-modal__aside-inner">
					<span class="subscribe-modal__mark">L</span>
					<h3>{t(locale, "subscribe.asideTitle")}</h3>
					<p>{t(locale, "subscribe.asideBody")}</p>
				</div>
			</aside>

			<div class="subscribe-modal__content">
				<p class="subscribe-modal__eyebrow">{t(locale, "subscribe.eyebrow")}</p>
				<h2 id="subscribe-modal-title">{t(locale, "subscribe.title")}</h2>
				<p class="subscribe-modal__lead">{t(locale, "subscribe.body")}</p>

				<div class="subscribe-modal__success" data-subscribe-success hidden>
					<div class="subscribe-modal__success-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.25">
							<path d="M20 6 9 17l-5-5"></path>
						</svg>
					</div>
					<strong data-subscribe-success-title>{t(locale, "subscribe.success")}</strong>
					<p data-subscribe-success-body>{t(locale, "subscribe.successBody")}</p>
				</div>

				<div class="subscribe-modal__form-wrap" data-subscribe-form-wrap>
					<p class="subscribe-modal__status" data-subscribe-status hidden></p>
					<form class="subscribe-modal__form" data-subscribe-form>
						<label class="subscribe-modal__label" for="subscribe-email-input">
							{t(locale, "subscribe.email")}
						</label>
						<input
							id="subscribe-email-input"
							type="email"
							name="email"
							required
							autocomplete="email"
							placeholder={t(locale, "subscribe.email")}
							data-subscribe-email
						/>
						<button type="submit" data-subscribe-submit>{t(locale, "subscribe.submit")}</button>
					</form>
					<p class="subscribe-modal__privacy">{t(locale, "subscribe.privacy")}</p>
				</div>
			</div>
		</div>
	</div>
</div>
<LoginModal locale={locale} />
<script>
	import { isAdminUser, loginUser } from "../lib/blog/auth";
	import { readStoredUser, storeUser } from "../lib/auth-session";
	import { addNewsletterSubscription } from "../lib/blog/newsletter";
	import { recordVisit } from "../lib/blog/visit-history";

	// Mobile menu toggle
	const toggleBtn = document.querySelector('[data-mobile-menu-toggle]') as HTMLButtonElement;
	const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement;
	const menuIcon = toggleBtn?.querySelector('.menu-icon') as SVGPathElement;
	const closeIcon = toggleBtn?.querySelector('.close-icon') as SVGPathElement;

	if (toggleBtn && mobileMenu) {
		toggleBtn.addEventListener('click', () => {
			const isOpen = mobileMenu.classList.contains('open');
			
			if (isOpen) {
				mobileMenu.classList.remove('open');
				menuIcon.style.display = '';
				closeIcon.style.display = 'none';
			} else {
				mobileMenu.classList.add('open');
				menuIcon.style.display = 'none';
				closeIcon.style.display = '';
			}
		});

		// Close menu when clicking a link
		const menuLinks = mobileMenu.querySelectorAll('.mobile-menu-link');
		menuLinks.forEach(link => {
			link.addEventListener('click', () => {
				mobileMenu.classList.remove('open');
				menuIcon.style.display = '';
				closeIcon.style.display = 'none';
			});
		});
	}

	const user = readStoredUser();
	const isAdmin = isAdminUser(user);
	const userBtn = document.querySelector<HTMLElement>("[data-header-user]");
	const mobileUser = document.querySelector<HTMLElement>("[data-mobile-user]");
	const headerEl = document.querySelector<HTMLElement>("header");
	const adminPath = headerEl?.dataset.adminHref;
	const spacePath = headerEl?.dataset.spaceHref || "/en/space/";

	recordVisit(window.location.pathname, document.title);

	const loginModal = document.querySelector<HTMLElement>("[data-login-modal]");
	const loginError = document.querySelector<HTMLElement>("[data-login-error]");
	const loginProviders = document.querySelector<HTMLElement>('[data-login-step="providers"]');
	const loginForm = document.querySelector<HTMLFormElement>("[data-login-form]");
	const loginEmail = document.querySelector<HTMLInputElement>("[data-login-email]");
	const loginPassword = document.querySelector<HTMLInputElement>("[data-login-password]");
	const loginSubmit = document.querySelector<HTMLButtonElement>("[data-login-submit]");
	const loginAdminHref = loginModal?.dataset.adminHref || adminPath || "/en/admin/";
	const loginSpaceHref = loginModal?.dataset.spaceHref || spacePath;

	const showLoginError = (message: string) => {
		if (!loginError) return;
		loginError.hidden = !message;
		loginError.textContent = message;
	};

	const showLoginStep = (step: "providers" | "email") => {
		if (loginProviders) loginProviders.hidden = step !== "providers";
		if (loginForm) loginForm.hidden = step !== "email";
	};

	const openLogin = () => {
		if (!loginModal) return;
		loginModal.hidden = false;
		document.body.style.overflow = "hidden";
		showLoginStep("providers");
		showLoginError("");
	};

	const closeLogin = () => {
		if (!loginModal) return;
		loginModal.hidden = true;
		document.body.style.overflow = "";
		showLoginError("");
		if (loginPassword) loginPassword.value = "";
		showLoginStep("providers");
	};

	const goAdminOrOpenLogin = (event: Event) => {
		event.preventDefault();
		if (isAdmin && adminPath) {
			window.location.href = adminPath;
			return;
		}
		if (user && spacePath) {
			window.location.href = spacePath;
			return;
		}
		openLogin();
	};

	userBtn?.addEventListener("click", goAdminOrOpenLogin);
	mobileUser?.addEventListener("click", goAdminOrOpenLogin);

	document.querySelectorAll("[data-login-open]").forEach((el) => {
		if (el === userBtn || el === mobileUser) return;
		el.addEventListener("click", (event) => {
			event.preventDefault();
			openLogin();
		});
	});

	document.querySelectorAll("[data-login-close]").forEach((el) => {
		el.addEventListener("click", () => closeLogin());
	});

	document.querySelectorAll("[data-login-provider]").forEach((el) => {
		el.addEventListener("click", () => {
			const provider = (el as HTMLElement).dataset.loginProvider;
			showLoginError(
				provider === "apple"
					? "Apple sign-in is not available yet. Continue with email."
					: "Google sign-in is not available yet. Continue with email."
			);
			showLoginStep("email");
		});
	});

	document.querySelector("[data-login-email-step]")?.addEventListener("click", () => {
		showLoginError("");
		showLoginStep("email");
		loginEmail?.focus();
	});

	document.querySelector("[data-login-back]")?.addEventListener("click", () => {
		showLoginError("");
		showLoginStep("providers");
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && loginModal && !loginModal.hidden) {
			closeLogin();
		}
	});

	loginForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const email = loginEmail?.value?.trim() || "";
		const password = loginPassword?.value || "";
		if (!email || !password) return;

		if (loginSubmit) {
			loginSubmit.disabled = true;
			loginSubmit.textContent = "Signing in…";
		}
		showLoginError("");

		try {
			const nextUser = await loginUser(email, password);
			storeUser(nextUser);
			window.location.href = isAdminUser(nextUser) ? loginAdminHref : loginSpaceHref;
		} catch (err) {
			showLoginError(err instanceof Error ? err.message : "Sign in failed.");
		} finally {
			if (loginSubmit) {
				loginSubmit.disabled = false;
				loginSubmit.textContent = "Continue with email";
			}
		}
	});

	// Deep-link: /login or ?signin=1 opens the popup on the current page.
	const params = new URLSearchParams(window.location.search);
	if (params.get("signin") === "1" || /\/login\/?$/.test(window.location.pathname)) {
		if (!isAdmin) openLogin();
	}

	const subscribeModal = document.querySelector<HTMLElement>("[data-subscribe-modal]");
	const subscribeForm = document.querySelector<HTMLFormElement>("[data-subscribe-form]");
	const subscribeFormWrap = document.querySelector<HTMLElement>("[data-subscribe-form-wrap]");
	const subscribeSuccess = document.querySelector<HTMLElement>("[data-subscribe-success]");
	const subscribeStatus = document.querySelector<HTMLElement>("[data-subscribe-status]");
	const subscribeSubmit = document.querySelector<HTMLButtonElement>("[data-subscribe-submit]");
	const subscribeEmail = document.querySelector<HTMLInputElement>("[data-subscribe-email]");
	const subscribeLabels = {
		submit: subscribeSubmit?.textContent || "Subscribe",
		submitting: "Subscribing…",
		success: "You're subscribed.",
		error: "Could not subscribe. Please try again.",
	};

	const resetSubscribeView = () => {
		if (subscribeFormWrap) subscribeFormWrap.hidden = false;
		if (subscribeSuccess) subscribeSuccess.hidden = true;
		if (subscribeStatus) {
			subscribeStatus.hidden = true;
			subscribeStatus.textContent = "";
			subscribeStatus.classList.remove("is-error", "is-success");
		}
	};

	const openSubscribe = () => {
		if (!subscribeModal) return;
		resetSubscribeView();
		subscribeModal.hidden = false;
		document.body.style.overflow = "hidden";
		subscribeEmail?.focus();
	};

	const closeSubscribe = () => {
		if (!subscribeModal) return;
		subscribeModal.hidden = true;
		document.body.style.overflow = "";
		resetSubscribeView();
	};

	document.querySelectorAll("[data-subscribe-open]").forEach((el) => {
		el.addEventListener("click", (event) => {
			event.preventDefault();
			openSubscribe();
		});
	});

	document.querySelectorAll("[data-subscribe-close]").forEach((el) => {
		el.addEventListener("click", () => closeSubscribe());
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && subscribeModal && !subscribeModal.hidden) {
			closeSubscribe();
		}
	});

	subscribeForm?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const email = subscribeEmail?.value?.trim() || "";
		if (!email) return;

		if (subscribeSubmit) {
			subscribeSubmit.disabled = true;
			subscribeSubmit.textContent = subscribeLabels.submitting;
		}
		if (subscribeStatus) {
			subscribeStatus.hidden = true;
			subscribeStatus.classList.remove("is-error", "is-success");
		}

		try {
			await addNewsletterSubscription(email, "header-subscribe");
			if (subscribeEmail) subscribeEmail.value = "";
			if (subscribeFormWrap) subscribeFormWrap.hidden = true;
			if (subscribeSuccess) subscribeSuccess.hidden = false;
			window.setTimeout(() => closeSubscribe(), 2200);
		} catch (err) {
			if (subscribeStatus) {
				subscribeStatus.hidden = false;
				subscribeStatus.classList.add("is-error");
				subscribeStatus.textContent =
					err instanceof Error ? err.message : subscribeLabels.error;
			}
		} finally {
			if (subscribeSubmit) {
				subscribeSubmit.disabled = false;
				subscribeSubmit.textContent = subscribeLabels.submit;
			}
		}
	});
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1.25em;
		background: #000;
		color: #fff;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 3.5rem;
		gap: 1rem;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.125rem;
	}

	.internal-links :global(a) {
		padding: 1em 0.75em;
		color: #fff;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 0.9375rem;
		font-weight: 400;
		transition: color 0.15s ease;
	}

	.internal-links :global(a:hover) {
		color: #d1d5db;
	}

	.internal-links :global(a.active) {
		border-bottom-color: #fff;
		font-weight: 500;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.header-subscribe {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.35rem 0.95rem;
		margin: 0;
		border: 1px solid #fff;
		border-radius: 999px;
		background: transparent;
		color: #fff;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1.2;
		white-space: nowrap;
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.header-subscribe:hover,
	.header-subscribe:focus-visible {
		background: #fff;
		color: #000;
		outline: none;
	}

	.header-user {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		margin: 0;
		background: none;
		border: none;
		box-shadow: none;
		outline: none;
		color: #fff;
		text-decoration: none;
		cursor: pointer;
		font: inherit;
		transition: color 0.15s ease, opacity 0.15s ease;
	}

	.header-user:hover,
	.header-user:focus,
	.header-user:focus-visible {
		background: none;
		border: none;
		box-shadow: none;
		outline: none;
		text-decoration: none;
		color: #d1d5db;
	}

	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.social-links a {
		padding: 0.25rem;
		color: #fff;
		text-decoration: none;
	}
	.social-links a:hover {
		color: #d1d5db;
	}

	.mobile-menu-toggle {
		display: none;
		background: transparent;
		border: none;
		color: #fff;
		cursor: pointer;
		padding: 0.5rem;
		margin: 0;
