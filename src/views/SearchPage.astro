---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_TITLE } from "../consts";
import { searchBlogPosts } from "../lib/parse/posts";
import { DEFAULT_LOCALE, getDir, localizedPath, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

type Props = { locale?: Locale };
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const query = (Astro.url.searchParams.get("q") ?? "").trim();
const results = query ? await searchBlogPosts(query) : [];
const dir = getDir(locale);
---

<!doctype html>
<html lang={locale} dir={dir}>
	<head>
		<BaseHead
			title={`${t(locale, "search.title")} · ${SITE_TITLE}`}
			description={t(locale, "search.description")}
			locale={locale}
			noindex
		/>
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
			}
			.search-header {
				margin-bottom: 2rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid rgba(var(--gray), 0.3);
			}
			.search-header h1 {
				margin: 0 0 0.35rem;
				font-size: 1.75rem;
			}
			.search-meta {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9375rem;
			}
			.search-hint {
				color: rgb(var(--gray));
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
			}
			.date {
				margin: 0.25rem 0 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 1rem;
				}
				ul li {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<section>
				<header class="search-header">
					<h1>
						{query ? `${t(locale, "search.resultsFor")} “${query}”` : t(locale, "search.title")}
					</h1>
					{
						query && (
							<p class="search-meta">
								{results.length === 1
									? t(locale, "search.countOne")
									: `${results.length} ${t(locale, "search.countMany")}`}
							</p>
						)
					}
				</header>

				{
					query ? (
						results.length === 0 ? (
							<p class="search-hint">{t(locale, "search.noResults")}</p>
						) : (
							<ul>
								{results.map((post) => (
									<li>
										<a href={localizedPath(locale, `/blog/${post.slug}/`)}>
											{post.imageUrl && <img width={720} height={360} src={post.imageUrl} alt="" />}
											<h4 class="title">{post.title}</h4>
											<p class="date">
												<FormattedDate date={new Date(post.publishedAt)} locale={locale} />
											</p>
										</a>
									</li>
								))}
							</ul>
						)
					) : (
						<p class="search-hint">{t(locale, "search.hint")}</p>
					)
				}
			</section>
		</main>
		<Footer locale={locale} />
	</body>
</html>
