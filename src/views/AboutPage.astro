---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { SITE_TITLE } from "../consts";
import { DEFAULT_LOCALE, getDir, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

type Props = { locale?: Locale };
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const dir = getDir(locale);
---

<!doctype html>
<html lang={locale} dir={dir}>
	<head>
		<BaseHead
			title={`${t(locale, "nav.about")} · ${SITE_TITLE}`}
			description={t(locale, "about.body")}
			locale={locale}
		/>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<article>
				<h1>{t(locale, "nav.about")}</h1>
				<p>{t(locale, "about.body")}</p>
			</article>
		</main>
		<Footer locale={locale} />
		<CookieBanner locale={locale} />
	</body>
</html>
