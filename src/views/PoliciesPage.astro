---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { SITE_TITLE } from "../consts";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";

type Props = { locale?: Locale };
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const dir = locale === "ar" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={locale} dir={dir}>
	<head>
		<BaseHead
			title={`${t(locale, "nav.policies")} · ${SITE_TITLE}`}
			description="Liberttin policies, terms, and guidelines"
			locale={locale}
		/>
		<style>
			.policies-container {
				max-width: 820px;
				margin: 0 auto;
			}

			.policies-container h1 {
				font-family: "Atkinson", sans-serif;
				margin-bottom: 0.5rem;
			}

			.policies-updated {
				color: rgb(var(--gray));
				font-size: 0.95rem;
				margin-bottom: 2rem;
			}

			.policies-nav {
				background: linear-gradient(135deg, #f6f8fb 0%, #ffffff 100%);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
				margin-bottom: 3rem;
			}

			.policies-nav h2 {
				font-family: "Atkinson", sans-serif;
				font-size: 1.1rem;
				margin: 0 0 1rem 0;
			}

			.policies-nav ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 0.75rem;
			}

			.policies-nav a {
				display: block;
				padding: 0.5rem 0.75rem;
				color: var(--accent);
				text-decoration: none;
				border-radius: 6px;
				transition: background 0.2s ease;
			}

			.policies-nav a:hover {
				background: rgba(var(--gray-light), 0.5);
			}

			.policy-section {
				margin-bottom: 4rem;
				padding-bottom: 3rem;
				border-bottom: 2px solid rgb(var(--gray-light));
			}

			.policy-section:last-child {
				border-bottom: none;
			}

			.policy-section h2 {
				font-family: "Atkinson", sans-serif;
				font-size: 2rem;
				margin-bottom: 1.5rem;
				color: rgb(var(--black));
				scroll-margin-top: 5rem;
			}

			.policy-section h3 {
				font-family: "Atkinson", sans-serif;
				font-size: 1.5rem;
				margin-top: 2rem;
				margin-bottom: 1rem;
				color: rgb(var(--black));
			}

			.policy-section p {
				line-height: 1.8;
				color: rgb(var(--gray-dark));
				margin-bottom: 1.25rem;
			}

			.policy-section ul,
			.policy-section ol {
				line-height: 1.8;
				color: rgb(var(--gray-dark));
				margin-bottom: 1.25rem;
				padding-left: 1.5rem;
			}

			.policy-section li {
				margin-bottom: 0.75rem;
			}

			.policy-highlight {
				background: #fef3c7;
				border-left: 4px solid #f59e0b;
				padding: 1rem 1.25rem;
				margin: 1.5rem 0;
				border-radius: 6px;
			}

			.policy-highlight strong {
				color: #92400e;
			}

			.policy-box {
				background: #f6f8fb;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 1.5rem;
				margin: 1.5rem 0;
			}

			.policy-box h4 {
				font-family: "Atkinson", sans-serif;
				margin: 0 0 0.75rem 0;
				color: rgb(var(--black));
			}

			@media (max-width: 720px) {
				.policies-nav ul {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<div class="policies-container">
				<article>
					<h1>{t(locale, "nav.policies")}</h1>
					<p class="policies-updated">Last Updated: August 20, 2026</p>

					<nav class="policies-nav">
						<h2>Quick Navigation</h2>
						<ul>
							<li><a href="#comments">Comments & Replies Policy</a></li>
							<li><a href="#privacy">Privacy Policy</a></li>
							<li><a href="#terms">Terms of Service</a></li>
							<li><a href="#content">Content Guidelines</a></li>
							<li><a href="#copyright">Copyright & DMCA</a></li>
							<li><a href="#cookies">Cookie Policy</a></li>
						</ul>
					</nav>

					<!-- Comments & Replies Policy -->
					<section class="policy-section" id="comments">
						<h2>Comments & Replies Policy</h2>
						
						<p>
							At Liberttin, we believe in fostering meaningful conversations and diverse perspectives. 
							Our comment system is designed to facilitate respectful dialogue while maintaining a safe and inclusive environment for all users.
						</p>

						<h3>General Guidelines</h3>
						<ul>
							<li><strong>Be Respectful:</strong> Treat others with courtesy and respect. Personal attacks, harassment, or bullying will not be tolerated.</li>
							<li><strong>Stay On Topic:</strong> Keep comments relevant to the article or discussion at hand.</li>
							<li><strong>No Spam:</strong> Avoid posting repetitive content, advertisements, or promotional links without context.</li>
							<li><strong>Use Appropriate Language:</strong> Profanity, hate speech, or discriminatory language is strictly prohibited.</li>
							<li><strong>Protect Privacy:</strong> Do not share personal information about yourself or others.</li>
						</ul>

						<h3>Prohibited Content</h3>
						<p>Comments containing the following will be removed:</p>
						<ul>
							<li>Threats of violence or harm</li>
							<li>Hate speech or discriminatory remarks based on race, ethnicity, religion, gender, sexual orientation, disability, or any other protected characteristic</li>
							<li>Harassment, bullying, or personal attacks</li>
							<li>Spam, advertising, or commercial promotion</li>
							<li>Misinformation or deliberately false information</li>
							<li>Illegal content or content promoting illegal activities</li>
							<li>Explicit sexual content or graphic violence</li>
						</ul>

						<div class="policy-highlight">
							<strong>Important:</strong> All comments are reviewed for compliance with our policies. 
							We reserve the right to remove any comment that violates these guidelines without prior notice.
						</div>

						<h3>Reply Guidelines</h3>
						<ul>
							<li>When replying to comments, address the argument, not the person</li>
							<li>Provide constructive feedback and thoughtful perspectives</li>
							<li>Use the reply feature to maintain threaded conversations</li>
							<li>Acknowledge good points from others, even if you disagree</li>
						</ul>

						<h3>Code Blocks & Formatting</h3>
						<p>
							Our comment system supports basic markdown formatting for code and inline code:
						</p>
						<div class="policy-box">
							<h4>Supported Formatting:</h4>
							<ul>
								<li>Inline code: Wrap text in backticks `like this`</li>
								<li>Code blocks: Use triple backticks with optional language identifier</li>
							</ul>
						</div>

						<h3>Moderation</h3>
						<p>
							Our moderation team reviews flagged content and takes appropriate action, which may include:
						</p>
						<ul>
							<li>Warning users about policy violations</li>
							<li>Removing comments that violate our guidelines</li>
							<li>Temporarily or permanently suspending user accounts for repeated violations</li>
						</ul>

						<h3>Reporting</h3>
						<p>
							If you encounter a comment that violates our policies, please contact us at 
							<a href="mailto:moderation@liberttin.blog">moderation@liberttin.blog</a> with the relevant details.
						</p>
					</section>

					<!-- Privacy Policy -->
					<section class="policy-section" id="privacy">
						<h2>Privacy Policy</h2>
						
						<p>
							Your privacy is important to us. This policy explains how we collect, use, and protect your personal information.
						</p>

						<h3>Information We Collect</h3>
						<ul>
							<li><strong>Content You Provide:</strong> Comments, replies, and contact form submissions</li>
							<li><strong>Usage Data:</strong> Pages visited, time spent, and interactions with our content</li>
							<li><strong>Technical Data:</strong> IP address, browser type, device information, and cookies</li>
						</ul>

						<h3>How We Use Your Information</h3>
						<ul>
							<li>To display your comments and facilitate discussions</li>
							<li>To improve our website and user experience</li>
							<li>To communicate with you regarding your inquiries</li>
							<li>To analyze site usage and trends</li>
							<li>To prevent abuse and enforce our policies</li>
						</ul>

						<h3>Data Retention</h3>
						<p>
							We retain your data only as long as necessary to provide our services and comply with legal obligations. 
							Comments are stored indefinitely unless you request removal.
						</p>

						<h3>Your Rights</h3>
						<ul>
							<li>Access your personal data</li>
							<li>Request correction of inaccurate data</li>
							<li>Request deletion of your data</li>
							<li>Opt-out of marketing communications</li>
							<li>Lodge a complaint with a supervisory authority</li>
						</ul>

						<div class="policy-box">
							<h4>Contact for Privacy Concerns:</h4>
							<p>Email us at <a href="mailto:privacy@liberttin.blog">privacy@liberttin.blog</a></p>
						</div>
					</section>

					<!-- Terms of Service -->
					<section class="policy-section" id="terms">
						<h2>Terms of Service</h2>
						
						<p>
							By accessing and using Liberttin, you agree to be bound by these Terms of Service and all applicable laws and regulations.
						</p>

						<h3>Acceptable Use</h3>
						<p>You agree to use our website only for lawful purposes and in accordance with these Terms. You agree not to:</p>
						<ul>
							<li>Violate any applicable laws or regulations</li>
							<li>Infringe on the intellectual property rights of others</li>
							<li>Transmit harmful code, viruses, or malicious software</li>
							<li>Attempt to gain unauthorized access to our systems</li>
							<li>Scrape, crawl, or otherwise collect data from our site without permission</li>
						</ul>

						<h3>User-Generated Content</h3>
						<p>
							By submitting comments or other content, you grant Liberttin a non-exclusive, worldwide, royalty-free license 
							to use, reproduce, modify, and display your content in connection with our services.
						</p>

						<h3>Disclaimer</h3>
						<p>
							Our content is provided "as is" without warranties of any kind. We do not guarantee the accuracy, 
							completeness, or usefulness of any information on our site.
						</p>

						<h3>Limitation of Liability</h3>
						<p>
							Liberttin shall not be liable for any indirect, incidental, special, consequential, or punitive damages 
							resulting from your use or inability to use our services.
						</p>
					</section>

					<!-- Content Guidelines -->
					<section class="policy-section" id="content">
						<h2>Content Guidelines</h2>
						
						<p>
							Our content aims to inform, educate, and inspire. We strive for accuracy, fairness, and respect in all our publications.
						</p>

						<h3>Editorial Standards</h3>
						<ul>
							<li><strong>Accuracy:</strong> We fact-check our content and correct errors promptly</li>
							<li><strong>Fairness:</strong> We present multiple perspectives on complex issues</li>
							<li><strong>Transparency:</strong> We disclose conflicts of interest and funding sources</li>
							<li><strong>Attribution:</strong> We credit sources and respect intellectual property</li>
						</ul>

						<h3>Corrections Policy</h3>
						<p>
							If you notice an error in our content, please contact us at 
							<a href="mailto:corrections@liberttin.blog">corrections@liberttin.blog</a>. 
							We will investigate and make corrections as appropriate, noting significant changes at the bottom of the article.
						</p>
					</section>

					<!-- Copyright & DMCA -->
					<section class="policy-section" id="copyright">
						<h2>Copyright & DMCA Policy</h2>
						
						<p>
							All content on Liberttin, including articles, images, and designs, is protected by copyright law.
						</p>

						<h3>Our Copyright</h3>
						<p>
							Unless otherwise stated, all content is © {new Date().getFullYear()} Liberttin. All rights reserved. 
							You may not reproduce, distribute, or create derivative works without our express written permission.
						</p>

						<h3>DMCA Notices</h3>
						<p>
							If you believe your copyright has been infringed, please send a DMCA notice to 
							<a href="mailto:dmca@liberttin.blog">dmca@liberttin.blog</a> including:
						</p>
						<ul>
							<li>Description of the copyrighted work</li>
							<li>URL of the allegedly infringing content</li>
							<li>Your contact information</li>
							<li>A statement of good faith belief</li>
							<li>A statement under penalty of perjury that the information is accurate</li>
							<li>Your physical or electronic signature</li>
						</ul>
					</section>

					<!-- Cookie Policy -->
					<section class="policy-section" id="cookies">
						<h2>Cookie Policy</h2>
						
						<p>
							We use cookies and similar technologies to enhance your browsing experience and analyze site traffic.
						</p>

						<h3>Types of Cookies We Use</h3>
						<div class="policy-box">
							<h4>Essential Cookies</h4>
							<p>Required for the website to function properly. These cannot be disabled.</p>
						</div>

						<div class="policy-box">
							<h4>Analytics Cookies</h4>
							<p>Help us understand how visitors interact with our website by collecting anonymous information.</p>
						</div>

						<div class="policy-box">
							<h4>Preference Cookies</h4>
							<p>Remember your settings and preferences, such as language selection.</p>
						</div>

						<h3>Managing Cookies</h3>
						<p>
							You can control cookies through your browser settings. Note that disabling certain cookies may affect 
							website functionality and your user experience.
						</p>

						<div class="policy-highlight">
							<strong>Note:</strong> By continuing to use our website, you consent to our use of cookies as described in this policy.
						</div>
					</section>

					<div class="policy-box">
						<h4>Questions or Concerns?</h4>
						<p>
							If you have any questions about these policies, please visit our 
							<a href="/contact">Contact page</a> or email us at 
							<a href="mailto:legal@liberttin.blog">legal@liberttin.blog</a>.
						</p>
					</div>
				</article>
			</div>
		</main>
		<Footer locale={locale} />
		<CookieBanner locale={locale} />

		<script>
			// Smooth scroll for anchor links
			document.querySelectorAll('a[href^="#"]').forEach(anchor => {
				anchor.addEventListener('click', function (e) {
					e.preventDefault();
					const target = document.querySelector(this.getAttribute('href') || '');
					if (target) {
						target.scrollIntoView({ behavior: 'smooth' });
					}
				});
			});
		</script>
	</body>
</html>
