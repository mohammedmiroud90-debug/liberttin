---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { DEFAULT_LOCALE, getDir, localizedPath, type Locale } from "../i18n/locales";
import { getPoliciesContent } from "../i18n/policies";
import { t } from "../i18n/ui";
import { pageTitle } from "../i18n/title";

type Props = { locale?: Locale };
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const dir = getDir(locale);
const content = getPoliciesContent(locale);
const contactHref = localizedPath(locale, "/contact/");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale} dir={dir}>
	<head>
		<BaseHead
			title={pageTitle(locale, "nav.policies")}
			description={content.description}
			locale={locale}
		/>
		<style>
			.policies-container {
				max-width: 820px;
				margin: 0 auto;
			}

			.policies-container h1 {
				font-family: "Atkinson", sans-serif;
				margin-bottom: 0.5rem;
			}

			.policies-updated {
				color: rgb(var(--gray));
				font-size: 0.95rem;
				margin-bottom: 2rem;
			}

			.policies-nav {
				background: linear-gradient(135deg, #f6f8fb 0%, #ffffff 100%);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
				margin-bottom: 3rem;
			}

			.policies-nav h2 {
				font-family: "Atkinson", sans-serif;
				font-size: 1.1rem;
				margin: 0 0 1rem 0;
			}

			.policies-nav ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 0.75rem;
			}

			.policies-nav a {
				display: block;
				padding: 0.5rem 0.75rem;
				color: var(--accent);
				text-decoration: none;
				border-radius: 6px;
				transition: background 0.2s ease;
			}

			.policies-nav a:hover {
				background: rgba(var(--gray-light), 0.5);
			}

			.policy-section {
				margin-bottom: 4rem;
				padding-bottom: 3rem;
				border-bottom: 2px solid rgb(var(--gray-light));
			}

			.policy-section h2 {
				font-family: "Atkinson", sans-serif;
				margin-bottom: 1rem;
			}

			.policy-section h3 {
				font-family: "Atkinson", sans-serif;
				margin-top: 1.75rem;
				margin-bottom: 0.75rem;
			}

			.policy-highlight {
				background: #fff7ed;
				border-inline-start: 4px solid #f97316;
				padding: 1rem 1.25rem;
				margin: 1.5rem 0;
			}

			.policy-box {
				background: #f8fafc;
				border: 1px solid rgb(var(--gray-light));
				padding: 1.25rem;
				margin: 1rem 0;
			}

			.policy-box h4 {
				font-family: "Atkinson", sans-serif;
				margin: 0 0 0.75rem 0;
				color: rgb(var(--black));
			}

			@media (max-width: 720px) {
				.policies-nav ul {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<div class="policies-container">
				<article>
					<h1>{t(locale, "nav.policies")}</h1>
					<p class="policies-updated">{content.updated}</p>

					<nav class="policies-nav">
						<h2>{content.navTitle}</h2>
						<ul>
							{
								content.sections.map((section) => (
									<li>
										<a href={`#${section.id}`}>{section.title}</a>
									</li>
								))
							}
						</ul>
					</nav>

					{
						content.sections.map((section) => (
							<section class="policy-section" id={section.id}>
								<h2>{section.title}</h2>
								{section.blocks.map((block) => {
									if (block.type === "p") return <p>{block.text.replace("{year}", String(year))}</p>;
									if (block.type === "h3") return <h3>{block.text}</h3>;
									if (block.type === "ul")
										return (
											<ul>
												{block.items.map((item) => (
													<li>{item}</li>
												))}
											</ul>
										);
									if (block.type === "highlight")
										return (
											<div class="policy-highlight">
												<strong>{block.label}</strong> {block.text}
											</div>
										);
									return (
										<div class="policy-box">
											<h4>{block.title}</h4>
											<p>{block.body}</p>
											{block.items && (
												<ul>
													{block.items.map((item) => (
														<li>{item}</li>
													))}
												</ul>
											)}
										</div>
									);
								})}
							</section>
						))
					}

					<div class="policy-box">
						<h4>{content.questionsTitle}</h4>
						<p>
							{content.questionsBody.split("{contact}")[0]}
							<a href={contactHref}>{content.contactLink}</a>
							{content.questionsBody.split("{contact}")[1] || ""}{" "}
							<a href="mailto:legal@liberttin.blog">legal@liberttin.blog</a>.
						</p>
					</div>
				</article>
			</div>
		</main>
		<Footer locale={locale} />
		<CookieBanner locale={locale} />

		<script>
			document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
				anchor.addEventListener("click", (e) => {
					e.preventDefault();
					const el = e.currentTarget;
					if (!(el instanceof HTMLAnchorElement)) return;
					const href = el.getAttribute("href") || "";
					const target = document.querySelector(href);
					if (target) target.scrollIntoView({ behavior: "smooth" });
				});
			});
		</script>
	</body>
</html>
