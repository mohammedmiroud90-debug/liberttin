---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import CookieBanner from "../components/CookieBanner.astro";
import DynamicTranslate from "../components/DynamicTranslate.astro";
import { SITE_TITLE } from "../consts";
import { getBlogPosts } from "../lib/parse/posts";
import { DEFAULT_LOCALE, getDir, localizedPath, type Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
import { pageTitle } from "../i18n/title";
import { localizeCategory } from "../i18n/category";

type Props = { locale?: Locale };
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const { items: posts } = await getBlogPosts(1, 6);
const dir = getDir(locale);
---

<!doctype html>
<html lang={locale} dir={dir}>
	<head>
		<BaseHead title={pageTitle(locale, "nav.home")} description={t(locale, "site.description")} locale={locale} />
		<style>
			.hero { margin-bottom: 2rem; }
			.hero h1 { margin-bottom: 0.5rem; }
			.latest-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				flex-wrap: wrap;
				margin-bottom: 0.5rem;
			}
			.latest-header h2 { margin: 0; }
			.post-list { list-style: none; margin: 0; padding: 0; }
			.post-list li {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding: 1.25rem 0;
			}
			.post-list a { text-decoration: none; color: inherit; }
			.post-list a:hover .post-title { color: var(--accent); }
			.post-title { margin: 0 0 0.35rem; font-size: 1.35rem; }
			.post-meta { margin: 0; color: rgb(var(--gray)); font-size: 0.95rem; }
			.view-all { display: inline-block; margin-top: 1.5rem; }
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p>{t(locale, "site.description")}</p>
			</section>
			<section>
				<div class="latest-header">
					<h2>{t(locale, "home.latest")}</h2>
					<DynamicTranslate locale={locale} targets=".post-list [data-i18n-dynamic]" />
				</div>
				{
					posts.length === 0 ? (
						<p>{t(locale, "home.empty")}</p>
					) : (
						<ul class="post-list">
							{posts.map((post) => (
								<li>
									<a href={localizedPath(locale, `/blog/${post.slug}/`)}>
										<h3 class="post-title" data-i18n-dynamic>{post.title}</h3>
										<p class="post-meta">
											<FormattedDate date={new Date(post.publishedAt)} locale={locale} />
											{post.category ? ` · ${localizeCategory(locale, post.category)}` : ""}
										</p>
									</a>
								</li>
							))}
						</ul>
					)
				}
				<a class="view-all" href={localizedPath(locale, "/blog/")}>{t(locale, "home.viewAll")}</a>
			</section>
		</main>
		<Footer locale={locale} />
		<CookieBanner locale={locale} />
	</body>
</html>
